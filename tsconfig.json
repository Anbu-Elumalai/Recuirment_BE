{
  "compilerOptions": {
    /* Language and Environment */
    "target": "es2016",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["src/types", "node_modules/@types"],  /* Specify multiple folders that act like './node_modules/@types'. */

    /* Output */
    "outDir": "dist",
    "rootDir": ".",      /* project root, because your source files are not under src/ */
    
    /* Source Maps */
    "sourceMap": true,
    
    /* Decorators (if needed) */
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  
  /* Include all your TypeScript source files */

  "include": ["src/types/**/*.d.ts", "api/**/*", "app/**/*", "infrastructure/**/*", "domain/**/*"],

  
  /* Exclude node_modules and dist */
  "exclude": ["node_modules", "dist"]
}
